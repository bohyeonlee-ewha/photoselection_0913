# PostgreSQL connection string. Keep the real password in .env only.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:6432/DATABASE
# Server-only OpenAI API key for image activity classification.
OPENAI_API_KEY=sk-...
# Optional OpenAI-compatible gateway URL.
OPENAI_BASE_URL=
# BizRouter Messages API model with image input support.
BIZROUTER_VISION_MODEL=anthropic/claude-fable-5
